# Core service configuration
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=n8n.192.168.8.40.nip.io
N8N_EDITOR_BASE_URL=https://n8n.192.168.8.40.nip.io
WEBHOOK_URL=https://n8n.192.168.8.40.nip.io
NODE_ENV=production
TZ=America/New_York
N8N_SECURE_COOKIE=false
N8N_PUBLIC_API_DISABLED=false
N8N_MCP_ENABLED=true
N8N_SKIP_AUTH_ON_OAUTH_CALLBACK=true

# Instance AI integrations
N8N_ENABLED_MODULES=instance-ai
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://n8n-sandbox-api.apps.svc.cluster.local:8080
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng.apps.svc.cluster.local:8080
